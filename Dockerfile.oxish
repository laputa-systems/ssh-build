# syntax=docker/dockerfile:1.18@sha256:dabfc0969b935b2080555ace70ee69a5261af8a8f1b4df97b9e7fbcf6722eddf

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS build

RUN apk add --no-cache \
        binutils=2.45.1-r1 \
        gcc=15.2.0-r5 \
        musl-dev=1.2.6-r3 \
        ca-certificates=20261020-r0 \
        file=5.47-r2

RUN case "$(apk --print-arch)" in \
        aarch64|x86_64) ;; \
        *) echo "unsupported Alpine architecture: $(apk --print-arch)" >&2; exit 1 ;; \
    esac

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/usr/local/bin:/usr/bin:/bin
ARG TARGETARCH
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_X86_64_SHA256=331228566cc931f32cd684f9bebc5956a5e5d7394c8d5de595f196a658ab98e6
ARG RUSTUP_AARCH64_SHA256=1ddf36182ac5d1782dbeefcb9bea7f5f9412d88f4a0d5047b1564a223624e8c6
RUN case "$TARGETARCH" in \
        amd64) arch=x86_64; sum=$RUSTUP_X86_64_SHA256 ;; \
        arm64) arch=aarch64; sum=$RUSTUP_AARCH64_SHA256 ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && wget -O /usr/local/bin/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${arch}-unknown-linux-musl/rustup-init" \
    && echo "$sum  /usr/local/bin/rustup-init" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/rustup-init
COPY rust-toolchain.toml /src/rust-toolchain.toml
WORKDIR /src
RUN rustup-init -y --no-modify-path --profile minimal --default-toolchain none \
    && rustup show active-toolchain \
    && rustc -V

COPY vendor/oxish /src/vendor/oxish
COPY vendor/graviola /src/vendor/graviola
COPY client/Cargo.toml client/Cargo.lock /src/client/
COPY client/src /src/client/src

# Static-PIE needs the system musl start files (rcrt1.o), which Rust's bundled ones are not, so the
# link uses Alpine's gcc and musl; libgcc_eh provides the _Unwind_* symbols Rust asks libunwind for.
# An explicit --target keeps these flags off build scripts and proc macros, which must stay dynamic.
RUN mkdir /opt/unwind-shim && ln -s "$(gcc -print-file-name=libgcc_eh.a)" /opt/unwind-shim/libunwind.a
ENV RUSTFLAGS="-C target-feature=+crt-static -C relocation-model=pic -C link-self-contained=no -C link-arg=-static-pie -L /opt/unwind-shim"
RUN triple="$(uname -m)-unknown-linux-musl" \
    && cargo build --locked --release --target "$triple" --manifest-path vendor/oxish/Cargo.toml -p oxish --bins \
    && cargo build --locked --release --target "$triple" --manifest-path client/Cargo.toml --bins \
    && mkdir /out \
    && cp "vendor/oxish/target/$triple/release/oxish-server" "vendor/oxish/target/$triple/release/oxish-session" /out/ \
    && cp "client/target/$triple/release/oxish-keygen" "client/target/$triple/release/oxish" \
        "client/target/$triple/release/oxish-sftp" "client/target/$triple/release/oxish-scp" /out/ \
    && rustc -vV > /out/rustc-version.txt

COPY scripts/qualify-binaries.sh scripts/oxish-bins.sh /tmp/

RUN . /tmp/oxish-bins.sh \
    && QUALIFY_BINS="$(oxish_bins /out)" sh /tmp/qualify-binaries.sh /out \
    && rm /tmp/qualify-binaries.sh /tmp/oxish-bins.sh

FROM scratch AS artifacts

COPY --from=build /out/ /
