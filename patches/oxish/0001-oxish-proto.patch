+    Chacha20Poly1305,
     /// An encryption algorithm not known to this implementation
     Unknown(Cow<'a, str>),
 }
@@ -319,6 +325,7 @@ impl EncryptionAlgorithm<'_> {
     pub fn to_owned(&self) -> EncryptionAlgorithm<'static> {
         match self {
             Self::Aes128Gcm => EncryptionAlgorithm::Aes128Gcm,
+            Self::Chacha20Poly1305 => EncryptionAlgorithm::Chacha20Poly1305,
             Self::Unknown(name) => EncryptionAlgorithm::Unknown(Cow::Owned(name.to_string())),
         }
     }
@@ -330,6 +337,12 @@ impl EncryptionAlgorithm<'_> {
                 key_len: 16,
                 iv_len: 12,
             }),
+            // Two 256-bit keys (packet body + packet length); the sequence
+            // number is the nonce, so no initial IV is derived.
+            Self::Chacha20Poly1305 => Some(KeyLengths {
+                key_len: 64,
+                iv_len: 0,
+            }),
             Self::Unknown(_) => None,
         }
     }
@@ -339,6 +352,7 @@ impl<'a> Named<'a> for EncryptionAlgorithm<'a> {
     fn typed(name: &'a str) -> Self {
         match name {
             "aes128-gcm@openssh.com" => Self::Aes128Gcm,
+            "chacha20-poly1305@openssh.com" => Self::Chacha20Poly1305,
             _ => Self::Unknown(Cow::Borrowed(name)),
         }
     }
@@ -346,6 +360,7 @@ impl<'a> Named<'a> for EncryptionAlgorithm<'a> {
     fn name(&self) -> &str {
         match self {
             Self::Aes128Gcm => "aes128-gcm@openssh.com",
+            Self::Chacha20Poly1305 => "chacha20-poly1305@openssh.com",
