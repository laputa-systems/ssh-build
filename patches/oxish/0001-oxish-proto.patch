@@ -310,6 +310,12 @@ pub enum EncryptionAlgorithm<'a> {
     ///
     /// As defined in <https://www.rfc-editor.org/rfc/rfc5647>.
     Aes128Gcm,
+    /// `chacha20-poly1305@openssh.com` encryption algorithm
+    ///
+    /// As defined in the OpenSSH PROTOCOL.chacha20poly1305@openssh.com
