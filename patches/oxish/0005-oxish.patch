+#[test]
+fn bad_length_prefixes_and_oversized_input_are_refused_when_they_arrive() {
+    let mut session = Session::new();
+    assert!(session.core.push(&u32s(0)).is_err());
+    let mut session = Session::new();
+    assert!(session.core.push(&u32s(MAX_PACKET as u32 + 1)).is_err());
+    let mut session = Session::new();
