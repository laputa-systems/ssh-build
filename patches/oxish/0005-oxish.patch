+        for value in ["version=1", "version=0", "version=2:x=y", "version=2 ", "", "version=2\n", "x"] {
+            assert_eq!(validate_protocol(value), None, "{value:?}");
+        }
+    }
+
+    #[test]
+    fn unsafe_configuration_is_rejected() {
