+        args.extend(["-i".into(), key_path.display().to_string()]);
+        args
+    }
+
+    fn new(addr: SocketAddr, key_path: &Path) -> Self {
+        let mut cmd = Command::new(Self::ssh());
+        cmd.args(Self::options(addr, key_path));
