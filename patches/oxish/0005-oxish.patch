+        let owner = Arc::new(PerIp::new(2));
+        let a: IpAddr = "192.0.2.1".parse().unwrap();
+        let b: IpAddr = "192.0.2.2".parse().unwrap();
+        let first = PerIp::acquire(&owner, a).unwrap();
+        let _second = PerIp::acquire(&owner, a).unwrap();
