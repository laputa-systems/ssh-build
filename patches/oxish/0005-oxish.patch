+
+fn signal_group(group: Option<Pid>, signal: Signal) {
+    if let Some(group) = group {
+        if let Err(error) = kill_process_group(group, signal) {
+            debug!(%error, ?signal, "error signaling git process group");
+        }
+    }
+}
+
+impl Drop for Process {
+    fn drop(&mut self) {
+        self.terminate();
+    }
+}
