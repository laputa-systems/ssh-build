diff --git a/fuzz/fuzz_targets/ssh_chacha_open.rs b/fuzz/fuzz_targets/ssh_chacha_open.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b4d01c496943588454b5aaba7a683702ff7e17ea
--- /dev/null
+++ b/fuzz/fuzz_targets/ssh_chacha_open.rs
@@ -0,0 +1,44 @@
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use proto::{
+    crypto::{KeySourceSide, OpeningKey as _, SealingKey as _},
+    named::EncryptionAlgorithm,
+};
+
+const HEADER: usize = 64 + 4 + 16;
+
+fuzz_target!(|data: &[u8]| {
+    let Some((header, packet)) = data.split_at_checked(HEADER) else {
+        return;
+    };
+
+    let source = KeySourceSide {
+        algorithm: EncryptionAlgorithm::Chacha20Poly1305,
+        encryption_key: header[..64].to_vec(),
+        initial_iv: Vec::new(),
+    };
+    let seq = u32::from_be_bytes(header[64..68].try_into().unwrap());
+    let tag = &header[68..];
+
+    let mut opener = provider::DEFAULT_PROVIDER.opening_key(0, &source).unwrap();
+    let mut opened = packet.to_vec();
+    if opener.open_in_place(seq, &mut opened, tag).is_err() {
+        // Authentication failed: the packet must be untouched, never partly decrypted.
+        let mut again = packet.to_vec();
+        let _ = provider::DEFAULT_PROVIDER
+            .opening_key(0, &source)
+            .unwrap()
+            .open_in_place(seq, &mut again, tag);
+        assert_eq!(again, packet);
+        return;
+    }
+
+    // An authentic packet must seal back to exactly what was received.
+    let mut sealer = provider::DEFAULT_PROVIDER.sealing_key(0, &source).unwrap();
+    let mut resealed = opened.clone();
+    let mut new_tag = [0u8; 16];
+    sealer.seal_in_place(seq, &mut resealed, &mut new_tag).unwrap();
+    assert_eq!(resealed, packet);
+    assert_eq!(new_tag, tag);
+});
diff --git a/fuzz/fuzz_targets/ssh_chacha_roundtrip.rs b/fuzz/fuzz_targets/ssh_chacha_roundtrip.rs
new file mode 100644
index 0000000000000000000000000000000000000000..17ce5355bdcb13f14950d91282068d1a3754363d
--- /dev/null
+++ b/fuzz/fuzz_targets/ssh_chacha_roundtrip.rs
@@ -0,0 +1,49 @@
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use proto::{
+    crypto::{KeySourceSide, OpeningKey as _, SealingKey as _},
+    named::EncryptionAlgorithm,
+};
+
+fuzz_target!(|data: &[u8]| {
+    let Some((header, plain)) = data.split_at_checked(64 + 4 + 1) else {
+        return;
+    };
+    if plain.len() < 4 {
+        return;
+    }
+
+    let source = KeySourceSide {
+        algorithm: EncryptionAlgorithm::Chacha20Poly1305,
+        encryption_key: header[..64].to_vec(),
+        initial_iv: Vec::new(),
+    };
+    let seq = u32::from_be_bytes(header[64..68].try_into().unwrap());
+    let flip = usize::from(header[68]);
+
+    let mut sealer = provider::DEFAULT_PROVIDER.sealing_key(0, &source).unwrap();
+    let mut packet = plain.to_vec();
+    let mut tag = [0u8; 16];
+    sealer.seal_in_place(seq, &mut packet, &mut tag).unwrap();
+
+    let mut opener = provider::DEFAULT_PROVIDER.opening_key(0, &source).unwrap();
+    let length = opener.decrypt_packet_length(seq, packet[..4].try_into().unwrap());
+    assert_eq!(length, plain[..4]);
+
+    let mut forged = packet.clone();
+    let mut forged_tag = tag;
+    let index = flip % (forged.len() + 16);
+    match forged.get_mut(index) {
+        Some(byte) => *byte ^= 1,
+        None => forged_tag[index - packet.len()] ^= 1,
+    }
+    let before = forged.clone();
+    assert!(opener.open_in_place(seq, &mut forged, &forged_tag).is_err());
+    assert_eq!(forged, before);
+
+    let mut opener = provider::DEFAULT_PROVIDER.opening_key(0, &source).unwrap();
+    let mut genuine = packet;
+    opener.open_in_place(seq, &mut genuine, &tag).unwrap();
+    assert_eq!(genuine, plain);
+});
